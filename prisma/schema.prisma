generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Farm {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())

  users             FarmUser[]
  paddocks          Paddock[]
  feedSettings      FeedSetting[]
  breaks            Break[]
  hsStaff           HS_Staff[]
  hsHazards         HS_Hazard[]
  hsMeetings        HS_Meeting[]
  hsObservations    HS_Observation[]
  hsIncidents       HS_Incident[]
  vehicles          Vehicle[]
  sensors           Sensor[]
  paddockExclusions PaddockExclusion[]
  paddockPartials   PaddockPartial[]
  calibrations      Calibration[]
  manualModes       ManualMode[]
}

model User {
  id       String     @id @default(uuid())
  email    String     @unique
  role     String     @default("USER") // ADMIN, USER
  provider String     @default("GOOGLE")
  farms    FarmUser[]
}

model FarmUser {
  id     String @id @default(uuid())
  farmId String
  userId String
  role   String @default("VIEWER") // OWNER, ADMIN, VIEWER, STAFF

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([farmId, userId])
}

model Paddock {
  id       String @id @default(uuid())
  farmId   String
  name     String
  boundary String // GeoJSON stored as string

  farm           Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  pastureRecords PastureRecord[]
  breaks         Break[]
}

model PastureRecord {
  id         String   @id @default(uuid())
  paddockId  String
  date       DateTime
  cover      Float? // Optional: so we can have NDVI-only records
  ndvi       Float? // Optional: so we can have manual-only records
  growthRate Float?
  cloudCover Float?
  tileUrl    String?
  type       String   @default("MANUAL") // 'MANUAL' or 'SATELLITE'

  paddock Paddock @relation(fields: [paddockId], references: [id], onDelete: Cascade)
}

model FeedSetting {
  id     String @id @default(uuid())
  farmId String
  key    String
  value  String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, key])
}

model Break {
  id             String    @id @default(uuid())
  farmId         String
  paddockId      String
  name           String
  vertices       String // JSON array of lat/lng
  areaHa         Float
  distanceMeters Float
  cropMode       String // polygon, line
  isCropBreak    Boolean   @default(false)
  status         String // marked, grazed
  createdAt      DateTime  @default(now())
  createdBy      String?
  deletedAt      DateTime?

  farm    Farm    @relation(fields: [farmId], references: [id], onDelete: Cascade)
  paddock Paddock @relation(fields: [paddockId], references: [id], onDelete: Cascade)
}

// Health & Safety
model HS_Staff {
  id     String @id @default(uuid())
  farmId String
  name   String
  role   String
  status String @default("ACTIVE")

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model HS_Hazard {
  id          String   @id @default(uuid())
  farmId      String
  description String
  status      String
  mitigation  String?
  date        DateTime @default(now())
  reportedBy  String?
  coordinates String? // JSON string of coordinates

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model HS_Meeting {
  id        String   @id @default(uuid())
  farmId    String
  date      DateTime
  topic     String
  attendees String // JSON or comma separated

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model HS_Observation {
  id          String   @id @default(uuid())
  farmId      String
  date        DateTime @default(now())
  observer    String
  description String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

model HS_Incident {
  id          String   @id @default(uuid())
  farmId      String
  date        DateTime @default(now())
  description String
  status      String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)
}

// Vehicles
model Vehicle {
  id          String  @id @default(uuid())
  farmId      String
  name        String
  type        String // Bikes/Quads, Cars/Utes, Tractors
  status      String  @default("in_service")
  oosReason   String?
  lastService String?
  isDeleted   Boolean @default(false)

  farm Farm             @relation(fields: [farmId], references: [id], onDelete: Cascade)
  logs MaintenanceLog[]
}

model MaintenanceLog {
  id            String   @id @default(uuid())
  vehicleId     String
  date          DateTime
  performedBy   String
  checkedPoints String // JSON
  notes         String?

  vehicle Vehicle @relation(fields: [vehicleId], references: [id], onDelete: Cascade)
}

// Sensors (ESP32/IoT)  
model Sensor {
  id         String   @id @default(uuid())
  farmId     String
  macAddress String   @unique
  type       String // e.g., 'fuel', 'soil_moisture', 'weather'  
  name       String
  location   String? // coordinates or description  
  lastActive DateTime @default(now())

  farm     Farm            @relation(fields: [farmId], references: [id], onDelete: Cascade)
  readings SensorReading[]
}

model SensorReading {
  id        String   @id @default(uuid())
  sensorId  String
  timestamp DateTime @default(now())
  payload   String // JSON string containing the sensor data  

  sensor Sensor @relation(fields: [sensorId], references: [id], onDelete: Cascade)
}

model PaddockExclusion {
  id          String @id @default(uuid())
  farmId      String
  paddockName String
  reason      String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, paddockName])
}

model PaddockPartial {
  id          String @id @default(uuid())
  farmId      String
  paddockName String
  status      String

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, paddockName])
}

model Calibration {
  id            String    @id @default(uuid())
  farmId        String
  paddockName   String
  measuredCover Float?
  date          DateTime?

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, paddockName])
}

model ManualMode {
  id          String @id @default(uuid())
  farmId      String
  paddockName String
  // Manual mode stores covers across multiple dates. 
  // We can just store it as a JSON object, or as records.
  // The CSV format is Date, 20/05, 11/05 \n W1, 1500, 1600.
  // Storing the entire table as JSON per farm is easiest to replicate CSV exactly.
  data        String // JSON string representing the matrix

  farm Farm @relation(fields: [farmId], references: [id], onDelete: Cascade)

  @@unique([farmId, paddockName])
}
